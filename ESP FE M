    WarningSize = 50,                        -- ขนาดลูกศรเตือน
    WarningMinDistance = 50,                 -- เริ่มเตือนเมื่อศัตรูเข้าใกล้ในระยะนี้
    WarningAngleThreshold = 45,              -- เริ่มเตือนเมื่อศัตรูอยู่ด้านหลัง +/- องศา

    -- Silhouette Chams Settings
    ChamsEnabled = true,
    ChamsColorEnemy = Color3.fromRGB(255, 50, 50), -- สีศัตรู (แดง)
    ChamsColorTeam = Color3.fromRGB(50, 200, 255),  -- สีเพื่อนร่วมทีม (น้ำเงิน)
    ChamsTransparency = 0.7,                 -- ความโปร่งใสของ Silhouette
