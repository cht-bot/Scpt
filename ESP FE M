    RadarEnabled = true,
    RadarPosition = UDim2.new(0, 50, 0, 50), -- ตำแหน่งเรดาร์ (x,y จากมุมซ้ายบน)
    RadarSize = UDim2.new(0, 150, 0, 150),   -- ขนาดเรดาร์
    RadarDotSize = 6,                        -- ขนาดจุดผู้เล่นบนเรดาร์
    RadarRange = 100,                        -- ระยะที่เรดาร์มองเห็น (เมตร)

    -- Warning Indicator Settings
    WarningEnabled = true,
